# Supabase. Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings -> API). Leave blank to keep running on
# the mocked, localStorage-only setup.
VITE_SUPABASE_URL=
# Prefer the modern publishable key (sb_publishable_...). The legacy anon key is
# still accepted via VITE_SUPABASE_ANON_KEY for backwards compatibility.
VITE_SUPABASE_PUBLISHABLE_KEY=
