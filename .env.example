# Supabase (required). Copy this file to .env.local and fill in the values from
# your Supabase project (Project Settings -> API). The app is backend-only and
# will not start without these. For production, set the same vars in your host
# (e.g. Netlify site settings).
VITE_SUPABASE_URL=
# Prefer the modern publishable key (sb_publishable_...). The legacy anon key is
# still accepted via VITE_SUPABASE_ANON_KEY for backwards compatibility.
VITE_SUPABASE_PUBLISHABLE_KEY=
